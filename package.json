{
  "name": "balon-patlat",
  "version": "1.0.0",
  "description": "Çocuklar için eğlenceli balon patlatma oyunu",
  "private": true,
  "scripts": {
    "build": "node scripts/copy-www.js",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "serve": "npx --yes serve www -p 4173"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/app": "^7.0.2",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2"
  }
}
